menu "batmon remote display"

    choice REMOTE_BOARD
        prompt "Board"
        default REMOTE_BOARD_CYD
        help
            Which board this image is for: the panel controller, the backlight pin and
            the touch controller's bus follow from it (main/board.h). Normally set by
            `tools/idf.ps1 -Board <name>` from boards/<name>.defaults rather than here.
            Wrong choice: a mirrored or negative picture, a dark screen, or dead touch.

        config REMOTE_BOARD_CYD
            bool "ESP32-2432S028R, single micro-USB (ILI9341)  [cyd]"
        config REMOTE_BOARD_CYD2USB
            bool "ESP32-2432S028R, USB-C + micro-USB (ST7789)  [cyd2usb]"
        config REMOTE_BOARD_JC2432W328R
            bool "GUITION JC2432W328R, resistive touch (ST7789)  [jc2432w328r]"
    endchoice

    config REMOTE_ROTATE_180
        bool "Rotate the picture 180 degrees"
        default n
        help
            Landscape either way; this flips which edge is the top. Touch follows.

    menu "Panel overrides"
        config REMOTE_PANEL_INVERT_FLIP
            bool "Invert colours the other way"
            default n
            help
                For a negative picture: black shows as white. The board's own setting
                is in main/board.h; this reverses it.
        config REMOTE_PANEL_BGR_FLIP
            bool "Swap red and blue"
            default n
            help
                For orange showing as blue. Flips the panel's RGB/BGR order.
    endmenu

    menu "Touch calibration (XPT2046)"
        config REMOTE_TOUCH_X_MIN
            int "Raw X at the left edge"
            default 200
        config REMOTE_TOUCH_X_MAX
            int "Raw X at the right edge"
            default 3700
        config REMOTE_TOUCH_Y_MIN
            int "Raw Y at the top edge"
            default 240
        config REMOTE_TOUCH_Y_MAX
            int "Raw Y at the bottom edge"
            default 3800
        # Touch mirrored on one axis: swap that axis's MIN and MAX.
        config REMOTE_TOUCH_SWAP_XY
            bool "Swap X and Y"
            default n
        config REMOTE_TOUCH_LOG
            bool "Log every touch, raw and mapped (for calibrating)"
            default n
    endmenu

endmenu
