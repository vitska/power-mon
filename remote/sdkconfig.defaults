# batmon-remote on the ESP32-2432S028 ("Cheap Yellow Display").

CONFIG_IDF_TARGET="esp32"

# 4 MB flash on every CYD seen so far: two 1.75 MB OTA slots (partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Firmware updates over BLE from the phone app (README.md). A new image boots on
# probation and the bootloader goes back to the old one unless it is confirmed -- by
# the app after it reconnects, or KEEP on the screen. Bootloader logging is cut to
# warnings: the classic ESP32's bootloader region is 28 KB and rollback needs room.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# The CYD's USB goes to a CH340 on UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- BLE: NimBLE, central and (for updates) peripheral ------------------------------
# A central towards the monitor. A peripheral too, advertising only while the Firmware
# update screen is open, so the phone app can send it a new image: one connection
# each way. Classic BT is compiled out; on the original ESP32 it costs ~30 KB of RAM
# even unused.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# Match the monitor's preferred MTU, so a `config` reply is a handful of notifications.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
# Pairing with a monitor in `ble pair bonded` mode: LE Secure Connections, passkey
# typed on the touch screen, bond kept in NVS so it happens once.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
